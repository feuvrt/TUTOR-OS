<Window x:Class="TutorOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorOS"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <StackPanel Grid.Column="0"
                    Background="black">

            <TextBlock Text="TutorOS"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="20"/>

            <Button Content="Ученики"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Расписание"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Домашние задания"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Оплаты"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Материалы"
                    Height="45"
                    Margin="10,5"/>

        </StackPanel>

        <Grid Grid.Column="1"
              Background="white"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ученики"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <DataGrid x:Name="StudentsTable"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Экзамен"
                                        Binding="{Binding Exam}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding Price}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Телефон"
                                        Binding="{Binding Phone}"
                                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>