<Window x:Class="TutorOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorOS"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       <!-- меню -->
        <StackPanel Grid.Column="0"
                    Background="black">

            <TextBlock Text="TutorOS"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="20"/>

            <Button Content="Ученики"
                    Height="45"
                    Margin="10,5"
                    Click="StudentsButton_Click"/>

            <Button Content="Расписание"
                    Height="45"
                    Margin="10,5"
                    Click="ScheduleButton_Click"/>

            <Button Content="Домашние задания"
                    Height="45"
                    Margin="10,5"
                    Click="HomeworkButton_Click"/>

            <Button Content="Оплаты"
                    Height="45"
                    Margin="10,5"
                    Click="PaymentsButton_Click"/>

            <Button Content="Материалы"
                    Height="45"
                    Margin="10,5"
                    Click="MaterialsButton_Click"/>

        </StackPanel>

        <!-- основная часть -->

        <Grid Grid.Column="1"
              Background="White">
            <Grid x:Name="StudentsSection"
                Margin="20">
            <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
</Grid.RowDefinitions>

<!-- 1 часть - ученики -->

            <TextBlock Text="Ученики"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

        <!-- редактирование раздела -->

    <StackPanel Grid.Row="1"
            Margin="0,0,0,20">

    <StackPanel Orientation="Horizontal">

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Имя"/>
            <TextBox x:Name="NameInput"
                     Width="140"
                     Height="25"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Экзамен"/>
            <TextBox x:Name="ExamInput"
                     Width="140"
                     Height="25"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Цена"/>
            <TextBox x:Name="PriceInput"
                     Width="90"
                     Height="25"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneInput"
                     Width="150"
                     Height="25"/>
        </StackPanel>

        <Button Content="Добавить"
                Width="100"
                Height="30"
                Margin="0,18,0,0"
                Click="AddStudent_Click"/>

        <Button Content="Удалить"
                Width="100"
                Height="30"
                Margin="10,18,0,0"
                Click="DeleteStudent_Click"/>
                
        <Button Content="Редактировать"
                Width="110"
                Height="30"
                Margin="10,18,0,0"
                Click="EditStudent_Click"/>

        <Button Content="Сохранить"
                Width="100"
                Height="30"
                Margin="10,18,0,0"
                Click="SaveStudent_Click"/>     
    </StackPanel>

</StackPanel>
            
              <!-- таблица учеников -->

            <DataGrid x:Name="StudentsTable"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Экзамен"
                                        Binding="{Binding Exam}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding Price}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Телефон"
                                        Binding="{Binding Phone}"
                                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>


<!-- 2 раздел - расписание -->

<Grid x:Name="ScheduleSection"
      Margin="20"
      Visibility="Collapsed">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <TextBlock Text="Расписание"
               FontSize="28"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
            Margin="0,0,0,20">

    <TextBlock Text="Добавить занятие"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

    <StackPanel Orientation="Horizontal">

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Ученик"/>
            <ComboBox x:Name="LessonStudentInput"
                      Width="140"
                      Height="25"
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Дата"/>
            <DatePicker x:Name="LessonDateInput"
                        Width="130"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Время"/>
            <TextBox x:Name="LessonTimeInput"
                     Width="70"
                     Height="25"
                     Text="18:00"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Тема"/>
            <TextBox x:Name="LessonTopicInput"
                     Width="140"
                     Height="25"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Минут"/>
            <TextBox x:Name="LessonDurationInput"
                     Width="60"
                     Height="25"
                     Text="60"/>
        </StackPanel>

        <Button Content="Добавить"
                Width="100"
                Height="30"
                Margin="0,18,0,0"
                Click="AddLesson_Click"/>
        <Button Content="Удалить"
                Width="100"
                Height="30"
                Margin="10,18,0,0"
                Click="DeleteLesson_Click"/>

        <Button Content="Проведено"
                Width="100"
                Height="30"
                Margin="10,18,0,0"
                Click="CompleteLesson_Click"/>
    </StackPanel>

</StackPanel>
    <DataGrid x:Name="LessonsTable"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Ученик"
                                Binding="{Binding StudentName}"
                                Width="*"/>

            <DataGridTextColumn Header="Дата и время"
                                Binding="{Binding ScheduledAt}"
                                Width="170"/>

            <DataGridTextColumn Header="Тема"
                                Binding="{Binding Topic}"
                                Width="*"/>

            <DataGridTextColumn Header="Минут"
                                Binding="{Binding DurationMinutes}"
                                Width="80"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding Status}"
                                Width="130"/>

        </DataGrid.Columns>

    </DataGrid>

</Grid>
<!-- 3 раздел - дз -->

<Grid x:Name="HomeworkSection"
      Margin="20"
      Visibility="Collapsed">

    <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
</Grid.RowDefinitions>

    <TextBlock Text="Домашние задания"
               FontSize="28"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

<StackPanel Grid.Row="1"
            Margin="0,0,0,20">

    <TextBlock Text="Добавить домашнее задание"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

    <StackPanel Orientation="Horizontal">

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Занятие"/>

            <ComboBox x:Name="HomeworkLessonInput"
                      Width="170"
                      Height="25"
                      DisplayMemberPath="DisplayName"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Дедлайн"/>

            <DatePicker x:Name="HomeworkDeadlineInput"
                        Width="120"/>
        </StackPanel>

        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Задание"/>

            <TextBox x:Name="HomeworkContentInput"
                     Width="180"
                     Height="25"/>
        </StackPanel>

        <Button Content="Добавить"
                Width="90"
                Height="30"
                Margin="0,18,0,0"
                Click="AddHomework_Click"/>

        <Button Content="Выполнено"
                Width="90"
                Height="30"
                Margin="10,18,0,0"
                Click="CompleteHomework_Click"/>
        <Button Content="Проверено"
            Width="90"
            Height="30"
            Margin="10,18,0,0"
            Click="CheckHomework_Click"/>

        <Button Content="Удалить"
                Width="80"
                Height="30"
                Margin="10,18,0,0"
                Click="DeleteHomework_Click"/>

    </StackPanel>

</StackPanel>
    <DataGrid x:Name="HomeworkTable"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Ученик"
                                Binding="{Binding StudentName}"
                                Width="*"/>

            <DataGridTextColumn Header="Дедлайн"
                                Binding="{Binding Deadline}"
                                Width="150"/>

            <DataGridTextColumn Header="Задание"
                                Binding="{Binding Content}"
                                Width="2*"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding Status}"
                                Width="120"/>

            <DataGridTextColumn Header="Комментарий"
                                Binding="{Binding TeacherComment}"
                                Width="*"/>

        </DataGrid.Columns>

    </DataGrid>

</Grid>

<!-- 4 раздел - оплаты -->

<Grid x:Name="PaymentsSection"
      Margin="20"
      Visibility="Collapsed">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Оплаты"
               FontSize="28"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

    <StackPanel Grid.Row="1"
                Margin="0,0,0,20">

        <TextBlock Text="Добавить оплату"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal">

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Ученик"/>

                <ComboBox x:Name="PaymentStudentInput"
                          Width="140"
                          Height="25"
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Сумма"/>

                <TextBox x:Name="PaymentAmountInput"
                         Width="90"
                         Height="25"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Дата"/>

                <DatePicker x:Name="PaymentDateInput"
                            Width="120"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Комментарий"/>

                <TextBox x:Name="PaymentCommentInput"
                         Width="160"
                         Height="25"/>
            </StackPanel>

            <Button Content="Добавить"
                    Width="90"
                    Height="30"
                    Margin="0,18,0,0"
                    Click="AddPayment_Click"/>

            <Button Content="Оплачено"
                    Width="90"
                    Height="30"
                    Margin="10,18,0,0"
                    Click="CompletePayment_Click"/>

            <Button Content="Удалить"
                    Width="80"
                    Height="30"
                    Margin="10,18,0,0"
                    Click="DeletePayment_Click"/>

        </StackPanel>

    </StackPanel>

    <DataGrid x:Name="PaymentsTable"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Ученик"
                                Binding="{Binding StudentName}"
                                Width="*"/>

            <DataGridTextColumn Header="Сумма"
                                Binding="{Binding Amount}"
                                Width="100"/>

            <DataGridTextColumn Header="Дата"
                                Binding="{Binding PaymentDate}"
                                Width="150"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding Status}"
                                Width="120"/>

            <DataGridTextColumn Header="Комментарий"
                                Binding="{Binding Comment}"
                                Width="*"/>

        </DataGrid.Columns>

    </DataGrid>

</Grid>

<!-- 5 раздел - материалы -->
        <StackPanel x:Name="MaterialsSection"
                        Margin="20"
                        Visibility="Collapsed">

                <TextBlock Text="Материалы"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Учебные материалы......."
                           FontSize="16"
                           Margin="0,20,0,0"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>