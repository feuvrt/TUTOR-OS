<Window x:Class="TutorOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorOS"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <StackPanel Grid.Column="0"
                    Background="black">

            <TextBlock Text="TutorOS"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="20"/>

            <Button Content="Ученики"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Расписание"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Домашние задания"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Оплаты"
                    Height="45"
                    Margin="10,5"/>

            <Button Content="Материалы"
                    Height="45"
                    Margin="10,5"/>

        </StackPanel>

        <Grid Grid.Column="1"
              Background="White"
              Margin="20">

            <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
</Grid.RowDefinitions>

            <TextBlock Text="Ученики"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,20">

                <TextBlock Text="Добавить ученика"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Имя"/>
                        <TextBox x:Name="NameInput"
                                 Width="140"
                                 Height="25"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Экзамен"/>
                        <TextBox x:Name="ExamInput"
                                 Width="140"
                                 Height="25"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Цена"/>
                        <TextBox x:Name="PriceInput"
                                 Width="90"
                                 Height="25"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Телефон"/>
                        <TextBox x:Name="PhoneInput"
                                 Width="150"
                                 Height="25"/>
                    </StackPanel>

                    <Button Content="Добавить"
                            Width="100"
                            Height="30"
                            Margin="0,18,0,0"
                            Click="AddStudent_Click"/>

                </StackPanel>

            </StackPanel>
            
            <DataGrid x:Name="StudentsTable"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Экзамен"
                                        Binding="{Binding Exam}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding Price}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Телефон"
                                        Binding="{Binding Phone}"
                                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>