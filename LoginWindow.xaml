<Window x:Class="TutorOS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorOS - Вход"
        Height="350"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="50">

        <TextBlock Text="TutorOS"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,30"/>

        <TextBlock Text="Логин"/>

        <TextBox x:Name="LoginInput"
                 Height="30"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Пароль"/>

        <PasswordBox x:Name="PasswordInput"
                     Height="30"
                     Margin="0,5,0,20"/>

        <Button Content="Войти"
                Height="35"
                Click="Login_Click"/>

        <Button Content="Создать аккаунт преподавателя"
                Height="35"
                Margin="0,10,0,0"
                Click="CreateTeacher_Click"/>

    </StackPanel>

</Window>