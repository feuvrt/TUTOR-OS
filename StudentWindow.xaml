<Window x:Class="TutorOS.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorOS"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">
        
        <Grid Margin="30">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="StudentNameText"
               Text="Личный кабинет"
               FontSize="28"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

    <TextBlock Grid.Row="1"
               Text="Моё расписание"
               FontSize="20"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

    <DataGrid x:Name="StudentLessonsTable"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="0,0,0,20">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Дата и время"
                                Binding="{Binding ScheduledAt}"
                                Width="170"/>

            <DataGridTextColumn Header="Тема"
                                Binding="{Binding Topic}"
                                Width="*"/>

            <DataGridTextColumn Header="Минут"
                                Binding="{Binding DurationMinutes}"
                                Width="80"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding Status}"
                                Width="130"/>

        </DataGrid.Columns>

    </DataGrid>

    <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,0,0,10">

    <TextBlock Text="Мои домашние задания"
               FontSize="20"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

    <Button Content="Выполнено"
            Width="110"
            Height="30"
            Margin="20,0,0,0"
            Click="CompleteHomework_Click"/>

</StackPanel>

    <DataGrid x:Name="StudentHomeworkTable"
              Grid.Row="4"
              AutoGenerateColumns="False"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Дедлайн"
                                Binding="{Binding Deadline}"
                                Width="150"/>

            <DataGridTextColumn Header="Задание"
                                Binding="{Binding Content}"
                                Width="2*"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding Status}"
                                Width="130"/>

            <DataGridTextColumn Header="Комментарий"
                                Binding="{Binding TeacherComment}"
                                Width="*"/>

        </DataGrid.Columns>

    </DataGrid>

</Grid>

</Window>